{
  "name": "@mwk719/dsh-restart",
  "version": "1.0.2",
  "description": "Windows 标题栏的「重启」按钮：点一下弹出确认框，确认后关闭并重新打开 DeepSeek Harness Desktop。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "restart-child.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "desktop",
    "cordis-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwk719/dsh-restart.git"
  },
  "homepage": "https://github.com/mwk719/dsh-restart#readme",
  "bugs": {
    "url": "https://github.com/mwk719/dsh-restart/issues"
  },
  "author": "minwk",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
